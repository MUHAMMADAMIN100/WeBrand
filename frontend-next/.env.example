# Base URL of the Django API (server- and client-side fetches). Defaults to
# http://localhost:8000 in code so local dev works without a .env file.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this site — used for canonical URLs, Open Graph, sitemap and
# robots. Defaults to https://webrand.tj in code.
NEXT_PUBLIC_SITE_URL=https://webrand.tj

# Google Analytics 4 Measurement ID. Wired via @next/third-parties in
# app/layout.tsx — GA loads ONLY when this is set, so leaving it empty disables
# analytics with no errors. Set it per environment (e.g. on Vercel); do not commit
# a real ID.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
