# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
# Keep DEBUG off everywhere except a trusted local machine. DEBUG=True leaks
# tracebacks, settings, and the URLconf on any error.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Set True in production (behind TLS) to force HTTPS + secure cookies + HSTS.
SECURE_SSL=False

# --- CORS (frontend origins, comma-separated) ---
CORS_ALLOWED_ORIGINS=https://webrand-flame.vercel.app,http://localhost:5173,http://localhost:5174

# --- CSRF (HTTPS origins allowed to POST to Django admin /admin/) ---
# Needed in prod so the Django admin login works over HTTPS. Include the scheme.
# e.g. CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Local dev defaults to SQLite if unset. In prod (Railway) set a Postgres URL —
# on Railway use the reference variable ${{Postgres.DATABASE_URL}}.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

# --- Object storage (S3-compatible) for uploaded media ---
# Leave ALL empty for local dev (media stays on the local filesystem).
# Setting key+secret+bucket switches media to S3 (logos public, resumes private).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# Endpoint of the S3-compatible provider, e.g. https://<account>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# Region (AWS: eu-central-1 etc.; R2: auto)
AWS_S3_REGION_NAME=
# Optional: public domain serving the bucket (R2 public/custom domain or CDN).
# Used for public media URLs (project logos) only; resumes never get public URLs.
AWS_S3_CUSTOM_DOMAIN=

# --- Telegram (get a NEW token from @BotFather — the old VITE_ one is leaked) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: separate chat for job applications (kind=application)
TELEGRAM_APPLICATIONS_CHAT_ID=
