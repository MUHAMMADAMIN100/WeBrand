# Base URL of the Django API. Optional locally — code defaults to http://localhost:8000.
# Set this in the admin's own Vercel project for production, e.g.:
# VITE_API_URL=https://api.webrand.tj
# VITE_API_URL=http://localhost:8000

# Origin of the public site, told to refresh its cached pages after a save (api/site.ts).
# Optional: by default it follows the API — a local API means http://localhost:3000,
# anything else https://www.webrand.tj.
# VITE_SITE_URL=https://www.webrand.tj
